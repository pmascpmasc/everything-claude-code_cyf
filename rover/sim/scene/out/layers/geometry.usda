def Xform "course"
{
    def "Looks"
    {
        def Material "asphalt" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </course/Looks/asphalt/PreviewSurface.outputs:surface>
            float physics:density = 2300
            float physics:dynamicFriction = 0.8
            float physics:restitution = 0.05
            float physics:staticFriction = 0.9
            token[] semantics:labels:material = ["asphalt"]

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.33, 0.34)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "hazard_yellow" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "SemanticsLabelsAPI:material"]
        )
        {
            token outputs:surface.connect = </course/Looks/hazard_yellow/PreviewSurface.outputs:surface>
            float physics:density = 1200
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0.1
            float physics:staticFriction = 0.6
            token[] semantics:labels:material = ["plastic"]

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.77, 0)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

